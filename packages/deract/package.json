{
  "name": "@atlis/deract",
  "version": "0.1.0",
  "description": "A tiny playground for isolated UI components. React optional, offline-first, unopinionated about what an entry renders.",
  "license": "MIT",
  "author": "Atlis <hello@atlis.dev>",
  "homepage": "https://github.com/atlis/deract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlis/deract.git",
    "directory": "packages/deract"
  },
  "bugs": { "url": "https://github.com/atlis/deract/issues" },
  "keywords": ["playground", "storybook", "components", "react", "devtools"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playground": {
      "types": "./dist/playground/index.d.ts",
      "import": "./dist/playground/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./logo.svg": "./dist/logo.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "DERACT-USAGE.md"
  ],
  "sideEffects": ["*.css"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}